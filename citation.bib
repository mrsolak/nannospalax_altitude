TITLE={Altitude shapes gut microbiome composition accounting for diet, thyroid hormone levels, and host genetics in a subterranean blind mole rat},
          
JOURNAL={Frontiers in Microbiology},
          
VOLUME={Volume 15 - 2024},
  
